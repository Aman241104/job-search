{
  // Cloudflare deployment of the dashboard frontend: static Next.js export
  // (out/) + a small Worker proxying /api and /auth to the Cloud Run backend.
  // Build + deploy:  npm run cf:deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-search",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /dashboard -> dashboard.html, the way Next's static export names pages
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only API/auth traffic runs the Worker; pages and chunks are served directly
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "vars": {
    "BACKEND_URL": "https://job-serach-api-119923500810.asia-south1.run.app"
  },
  "observability": { "enabled": true }
}
